# Configuration Supabase publique (accessible côté client Astro)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy

# Clé API Google Cloud Console (pour scripts/generate-article.mjs via @google/genai)
# Activez l'API « Generative Language API » (generativelanguage.googleapis.com)
# sur votre projet Google Cloud, puis créez une clé API dans API et services > Identifiants.
GOOGLE_API_KEY=

# Optionnel : pour utiliser Vertex AI (mode Express avec clé API Google Cloud)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# Optionnel : modèle Gemini prioritaire pour la génération d'articles
# GEMINI_MODEL=gemini-2.5-flash
