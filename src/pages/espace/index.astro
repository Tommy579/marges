    deleteUserScheduleEvent,
    fetchUserReminders,
    createUserReminder,
    toggleUserReminder,
    deleteUserReminder,
    type DbCourse,
    type DbScheduleEvent,
    type DbReminder,
  } from '../../utils/supabase';
  import { STORAGE_KEYS, loadPersistent, savePersistent } from '../../utils/persistence';
  import { syncTimetableState, parseIcsEvents, type ParsedCalendarEvent } from '../../utils/timetable';
  import { url } from '../../utils/url';
  import { setupPdfViewerModal, openPdfViewer } from '../../utils/pdfViewer';
  import { processFolderUpload } from '../../utils/courseImport';
