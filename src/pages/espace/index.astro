    });
    btnCancelSchedule?.addEventListener('click', () => {
      if (modalSchedule) modalSchedule.style.display = 'none';
    });

    formSaveSchedule?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('schedule-input-title') as HTMLInputElement).value.trim();
      const day_of_week = parseInt((document.getElementById('schedule-input-day') as HTMLSelectElement).value, 10);
      const start_time = (document.getElementById('schedule-input-start') as HTMLInputElement).value;
      const end_time = (document.getElementById('schedule-input-end') as HTMLInputElement).value;
      const location = (document.getElementById('schedule-input-location') as HTMLInputElement).value.trim();
      const notes = (document.getElementById('schedule-input-notes') as HTMLInputElement).value.trim();

      try {
        await createUserScheduleEvent({
          title,
          day_of_week,
          start_time,
          end_time,
          location: location || undefined,
          notes: notes || undefined,
        });
        if (modalSchedule) modalSchedule.style.display = 'none';
        notify('Créneau ajouté à l’emploi du temps.');
        await loadSchedule();
      } catch (err: any) {
        notify(formatSupabaseError(err), true);
      }
    });

    // -------------------------------------------------------------
    // GESTION DES RAPPELS
    // -------------------------------------------------------------
    async function loadReminders() {
      if (remindersLoading && (!remindersList || remindersList.children.length === 0)) {
        remindersLoading.style.display = 'block';
        remindersLoading.textContent = 'Chargement de vos rappels...';
      }
      if (remindersEmpty) remindersEmpty.style.display = 'none';
      try {
        cachedReminders = await fetchUserReminders();
        if (badgeReminders) badgeReminders.textContent = String(cachedReminders.length);
        renderReminders();
      } catch (err: any) {
        if (remindersLoading) {
          remindersLoading.style.display = 'block';
          remindersLoading.innerHTML = `<span style="color: var(--danger);">${esc(formatSupabaseError(err))}</span>`;
        }
      } finally {
        if (remindersLoading && (cachedReminders.length > 0 || (remindersEmpty && remindersEmpty.style.display === 'block'))) {
          remindersLoading.style.display = 'none';
        }
      }
    }

    function renderReminders() {
      if (!remindersList) return;
      remindersList.innerHTML = '';
      if (cachedReminders.length === 0) {
        if (remindersEmpty) remindersEmpty.style.display = 'block';
        return;
      }
      if (remindersEmpty) remindersEmpty.style.display = 'none';

      cachedReminders.forEach((r) => {
        const item = document.createElement('div');
        item.className = 'panel reminder-row';
        const timeFormatted = r.time_of_day.slice(0, 5);

        item.innerHTML = `
          <div class="reminder-left">
            <span class="tag-pill tag-kind">${esc(r.kind)}</span>
            <strong class="reminder-label">${esc(r.label || 'Rappel')}</strong>
            <span class="reminder-time-tag">${timeFormatted}</span>
          </div>
          <div class="reminder-actions">
            <label class="toggle-switch" title="Activer / Désactiver">
              <input type="checkbox" class="chk-toggle-reminder" ${r.enabled ? 'checked' : ''} />
              <span class="toggle-slider"></span>
            </label>
            <button type="button" class="btn btn--danger btn--sm btn-del-reminder">Supprimer</button>
          </div>
        `;

        item.querySelector('.chk-toggle-reminder')?.addEventListener('change', async (e) => {
          const target = e.target as HTMLInputElement;
          try {
            if (r.id) await toggleUserReminder(r.id, target.checked);
            notify(`Rappel ${target.checked ? 'activé' : 'désactivé'}.`);
          } catch (err: any) {
            notify(err.message, true);
            target.checked = !target.checked;
          }
        });

        item.querySelector('.btn-del-reminder')?.addEventListener('click', async () => {
          if (confirm(`Supprimer le rappel "${r.label}" ?`)) {
            try {
              if (r.id) await deleteUserReminder(r.id);
              notify('Rappel supprimé.');
              await loadReminders();
            } catch (err: any) {
              notify(err.message, true);
            }
          }
        });

        remindersList.appendChild(item);
      });
    }

    // Modal Rappel
    const modalReminder = document.getElementById('modal-reminder');
    const btnOpenReminderModal = document.getElementById('btn-open-reminder-modal');
    const btnCreateFirstReminder = document.getElementById('btn-create-first-reminder');
    const btnCloseReminderModal = document.getElementById('btn-close-reminder-modal');
    const btnCancelReminder = document.getElementById('btn-cancel-reminder');
    const formSaveReminder = document.getElementById('form-save-reminder') as HTMLFormElement;

