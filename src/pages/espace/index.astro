  import { renderNotionMarkdown as renderMarkdown } from '../../utils/notes';
  import { esc } from '../../utils/escape';
  import { groupCoursesBySubject, sortSubjects, sortFolders, courseSubject } from '../../utils/courseTree';

  const DAY_NAMES = ['', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];

  function initEspace() {
    const viewLogin = document.getElementById('view-login');
    const viewDashboard = document.getElementById('view-dashboard');
    const espaceHeroHeader = document.getElementById('espace-hero-header');
    const userTopActions = document.getElementById('user-top-actions');
    const userDisplayEmail = document.getElementById('user-display-email');
    const btnLogout = document.getElementById('btn-logout');

    const formLogin = document.getElementById('form-login') as HTMLFormElement;
    const loginEmailInput = document.getElementById('login-email') as HTMLInputElement;
    const loginPwdInput = document.getElementById('login-password') as HTMLInputElement;
    const btnTogglePwdVis = document.getElementById('btn-toggle-pwd-vis');
    const loginErrorBox = document.getElementById('login-error-box');
    const loginErrorText = document.getElementById('login-error-text');

    btnTogglePwdVis?.addEventListener('click', () => {
      if (!loginPwdInput) return;
      const isPwd = loginPwdInput.type === 'password';
      loginPwdInput.type = isPwd ? 'text' : 'password';
      btnTogglePwdVis.textContent = isPwd ? 'Masquer' : 'Afficher';
    });

    const espaceBanner = document.getElementById('espace-banner');
    const espaceBannerText = document.getElementById('espace-banner-text');

    // Configuration Supabase intégrée
    const boxSupabaseInline = document.getElementById('box-supabase-inline');
    const btnToggleSupabase = document.getElementById('btn-toggle-supabase-config');
    const btnCloseInlineSupabase = document.getElementById('btn-close-inline-supabase');
    const formInlineSupabase = document.getElementById('form-inline-supabase') as HTMLFormElement | null;
    const inlineSupabaseUrl = document.getElementById('inline-supabase-url') as HTMLInputElement | null;
    const inlineSupabaseKey = document.getElementById('inline-supabase-key') as HTMLInputElement | null;
    const btnResetDefaultSupabase = document.getElementById('btn-reset-default-supabase');

    btnToggleSupabase?.addEventListener('click', () => {
      if (!boxSupabaseInline) return;
      const isHidden = boxSupabaseInline.style.display === 'none';
      boxSupabaseInline.style.display = isHidden ? 'block' : 'none';
      const creds = getSupabaseCredentials();
      if (inlineSupabaseUrl) inlineSupabaseUrl.value = creds.url;
      if (inlineSupabaseKey) inlineSupabaseKey.value = creds.anonKey;
    });

    btnCloseInlineSupabase?.addEventListener('click', () => {
      if (boxSupabaseInline) boxSupabaseInline.style.display = 'none';
    });

    btnResetDefaultSupabase?.addEventListener('click', async () => {
      resetSupabaseCredentialsToDefault();
      const creds = getSupabaseCredentials();
      if (inlineSupabaseUrl) inlineSupabaseUrl.value = creds.url;
      if (inlineSupabaseKey) inlineSupabaseKey.value = creds.anonKey;
      notify('Clés officielles de Supabase restaurées.');
      await refreshSessionState();
    });

    formInlineSupabase?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!inlineSupabaseUrl || !inlineSupabaseKey) return;
      const u = inlineSupabaseUrl.value.trim();
      const k = inlineSupabaseKey.value.trim();
      if (!u || !k) return;
      saveSupabaseCredentials(u, k);
      notify('Configuration Supabase enregistrée avec succès.');
      if (boxSupabaseInline) boxSupabaseInline.style.display = 'none';
      await refreshSessionState();
    });

    // Badges
    const badgeCourses = document.getElementById('badge-courses-count');
    const badgeSchedule = document.getElementById('badge-schedule-count');
    const badgeReminders = document.getElementById('badge-reminders-count');

    // Containers
    const coursesGrid = document.getElementById('courses-grid');
    const coursesLoading = document.getElementById('courses-list-loading');
    const coursesEmpty = document.getElementById('courses-list-empty');
    const coursesSelectionBar = document.getElementById('courses-selection-bar');
    const chkSelectAllCourses = document.getElementById('chk-select-all-courses') as HTMLInputElement | null;
    const selectedCoursesCount = document.getElementById('selected-courses-count');
    const selectedCoursesText = document.getElementById('selected-courses-text');
    const btnDeleteSelectedCourses = document.getElementById('btn-delete-selected-courses');
    const btnPurgeAllCourses = document.getElementById('btn-purge-all-courses');

    let selectedCourseIds = new Set<string>();

    const scheduleGrid = document.getElementById('schedule-days-container');
    const scheduleLoading = document.getElementById('schedule-list-loading');
    const scheduleEmpty = document.getElementById('schedule-list-empty');

    const remindersList = document.getElementById('reminders-list');
    const remindersLoading = document.getElementById('reminders-list-loading');
    const remindersEmpty = document.getElementById('reminders-list-empty');

    let cachedCourses: DbCourse[] = [];
    let cachedSchedule: DbScheduleEvent[] = [];
    let cachedReminders: DbReminder[] = [];
    let activeScheduleDate = new Date();

    function notify(msg: string, isError = false) {
      toast(msg, isError ? 'error' : 'info');
      if (!espaceBanner || !espaceBannerText) return;
      espaceBannerText.textContent = msg;
      espaceBanner.className = isError ? 'panel espace-banner banner-error' : 'panel espace-banner';
      espaceBanner.style.display = 'flex';
      setTimeout(() => {
        if (espaceBanner) espaceBanner.style.display = 'none';
      }, 5000);
    }

    // Gestion des onglets
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const tabPanels: Record<string, HTMLElement | null> = {
      courses: document.getElementById('tab-panel-courses'),
      schedule: document.getElementById('tab-panel-schedule'),
      reminders: document.getElementById('tab-panel-reminders'),
      security: document.getElementById('tab-panel-security'),
    };

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        if (!tab) return;
        tabButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        Object.entries(tabPanels).forEach(([k, panel]) => {
          if (panel) panel.style.display = k === tab ? 'block' : 'none';
        });
        if (tab === 'schedule') {
          loadSchedule().catch(() => {});
        } else if (tab === 'courses') {
          loadCourses().catch(() => {});
        }
      });
    });

    // Écoute de session
    async function refreshSessionState() {
      const { url: currentUrl, anonKey: currentKey, isConfigured } = getSupabaseCredentials();
      const isExplicitSetup = window.location.search.includes('setup=1') || window.location.hash.includes('supabase');

      if (!isConfigured) {
        if (loginErrorBox && loginErrorText) {
          loginErrorBox.style.display = 'block';
          loginErrorText.textContent =
            'Supabase n’est pas encore configuré avec vos clés réelles. Renseignez votre Project URL et clé publique ci-dessous pour vous connecter.';
        }
        if (boxSupabaseInline) boxSupabaseInline.style.display = 'block';
      } else {
        if (loginErrorBox && loginErrorText && loginErrorText.textContent?.includes('Supabase n’est pas encore configuré')) {
          loginErrorBox.style.display = 'none';
        }
        if (boxSupabaseInline && !isExplicitSetup) {
          boxSupabaseInline.style.display = 'none';
        }
      }

      if (inlineSupabaseUrl && !inlineSupabaseUrl.value && !currentUrl.includes('xxxx.supabase.co')) {
        inlineSupabaseUrl.value = currentUrl;
      }
      if (inlineSupabaseKey && !inlineSupabaseKey.value && !currentKey.includes('dummy')) {
        inlineSupabaseKey.value = currentKey;
      }

      try {
        const session = await getCurrentSession();
        if (session && session.user) {
          if (viewLogin) viewLogin.style.display = 'none';
          if (viewDashboard) viewDashboard.style.display = 'block';
          if (espaceHeroHeader) espaceHeroHeader.style.display = 'block';
          if (userTopActions) userTopActions.style.display = 'flex';
          if (userDisplayEmail) {
            const fullName = session.user.user_metadata?.full_name;
            userDisplayEmail.textContent = fullName ? `${fullName} (${session.user.email})` : (session.user.email || 'Connecté');
          }
          // Purge de sécurité : si l'ancien profil contient un gros fichier ICS dans les métadonnées auth, on le nettoie une seule fois
          if (session.user.user_metadata?.timetable_ics) {
            session.user.user_metadata.timetable_ics = null;
            getSupabase().auth.updateUser({ data: { timetable_ics: null } }).catch(() => {});
          }

          try {
            await Promise.all([loadCourses(), loadSchedule(), loadReminders()]);
          } catch (loadErr: any) {
            console.error('Erreur globale dashboard:', loadErr);
          }
        } else {
          if (viewLogin) viewLogin.style.display = 'block';
          if (viewDashboard) viewDashboard.style.display = 'none';
          if (espaceHeroHeader) espaceHeroHeader.style.display = 'none';
          if (userTopActions) userTopActions.style.display = 'none';
        }
      } catch (err: any) {
        console.error('Erreur session:', err);
      }
    }

    // Connexion
    formLogin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (loginErrorBox) loginErrorBox.style.display = 'none';
      const email = loginEmailInput.value.trim();
      const pwd = loginPwdInput.value;

      try {
        const btn = document.getElementById('btn-submit-login') as HTMLButtonElement;
        if (btn) btn.disabled = true;
        await loginWithPassword(email, pwd);
        notify('Connexion réussie.');
        document.documentElement.classList.add('is-authenticated');
        const redirectParam = new URLSearchParams(window.location.search).get('redirect');
        if (redirectParam && redirectParam.startsWith('/')) {
          window.location.replace(redirectParam);
          return;
        }
        await refreshSessionState();
      } catch (err: any) {
        if (loginErrorBox && loginErrorText) {
          loginErrorBox.style.display = 'block';
          loginErrorText.textContent = err.message || 'Échec de connexion. Vérifiez vos identifiants.';
        }
      } finally {
        const btn = document.getElementById('btn-submit-login') as HTMLButtonElement;
        if (btn) btn.disabled = false;
      }
    });

    // Déconnexion
    btnLogout?.addEventListener('click', async () => {
      try {
        await logoutUser();
        document.documentElement.classList.remove('is-authenticated');
        notify('Vous avez été déconnecté.');
        await refreshSessionState();
      } catch (err: any) {
        notify(err.message, true);
      }
    });

    const btnResetSession = document.getElementById('btn-reset-session');
    btnResetSession?.addEventListener('click', async () => {
      await logoutUser();
      document.documentElement.classList.remove('is-authenticated');
      notify('Session locale purgée. Reconnectez-vous pour obtenir un jeton neuf.');
      await refreshSessionState();
    });

    // -------------------------------------------------------------
    // GESTION DES COURS
    // -------------------------------------------------------------
    async function loadCourses() {
      // 1. Chargement instantané depuis le cache local (0 ms de latence)
      const immediate = getUserCoursesImmediate();
      cachedCourses = immediate;
      if (badgeCourses) badgeCourses.textContent = String(cachedCourses.length);
      renderCourses();
      if (coursesLoading) coursesLoading.style.display = 'none';
      if (coursesEmpty) coursesEmpty.style.display = cachedCourses.length === 0 ? 'block' : 'none';

      // 2. Synchronisation distante en arrière-plan sans perturber l'interface
      try {
        const remote = await fetchUserCourses().catch(() => immediate);
        if (remote) {
          const isDifferent =
            remote.length !== cachedCourses.length ||
            JSON.stringify(remote.map((r) => r.id)) !== JSON.stringify(cachedCourses.map((c) => c.id));

          cachedCourses = remote;
          if (badgeCourses) badgeCourses.textContent = String(cachedCourses.length);
          if (isDifferent || !coursesGrid || coursesGrid.children.length === 0) {
            renderCourses();
          }
        }
      } catch (err: any) {
        console.warn('[Courses] Synchronisation en arrière-plan:', err);
      } finally {
        if (coursesLoading) coursesLoading.style.display = 'none';
        if (coursesEmpty) coursesEmpty.style.display = cachedCourses.length === 0 ? 'block' : 'none';
      }
    }

    // Réagir immédiatement aux créations/suppressions de cours déclenchées depuis d'autres pages ou onglets
    window.addEventListener('marges:courses-changed', () => {
      loadCourses().catch(() => {});
    });
    window.addEventListener('storage', (e) => {
      if (e.key && (e.key.startsWith('marges_user_courses_') || e.key === 'marges_deleted_courses_tombstones')) {
        loadCourses().catch(() => {});
      }
    });

    function updateSelectionUI() {
      const validSelected = Array.from(selectedCourseIds).filter((id) =>
        cachedCourses.some((c) => c.id === id)
      );
      selectedCourseIds = new Set(validSelected);
      const count = selectedCourseIds.size;

      if (selectedCoursesCount) selectedCoursesCount.textContent = String(count);
      if (selectedCoursesText) {
        selectedCoursesText.textContent =
          count === 0 ? '0 cours sélectionné' : `${count} cours sélectionné${count > 1 ? 's' : ''}`;
      }

      if (btnDeleteSelectedCourses) {
        btnDeleteSelectedCourses.style.display = count > 0 ? 'inline-flex' : 'none';
      }

      if (chkSelectAllCourses) {
        if (cachedCourses.length > 0 && count === cachedCourses.length) {
          chkSelectAllCourses.checked = true;
          chkSelectAllCourses.indeterminate = false;
        } else if (count > 0) {
          chkSelectAllCourses.checked = false;
          chkSelectAllCourses.indeterminate = true;
        } else {
          chkSelectAllCourses.checked = false;
          chkSelectAllCourses.indeterminate = false;
        }
      }

      coursesGrid?.querySelectorAll<HTMLDivElement>('.course-card').forEach((card) => {
        const chk = card.querySelector<HTMLInputElement>('.chk-select-course');
        if (chk && chk.dataset.id) {
          const isSelected = selectedCourseIds.has(chk.dataset.id);
          chk.checked = isSelected;
          card.classList.toggle('course-card--selected', isSelected);
        }
      });
    }

    function renderCourses() {
      if (!coursesGrid) return;
      coursesGrid.innerHTML = '';
      if (cachedCourses.length === 0) {
        if (coursesEmpty) coursesEmpty.style.display = 'block';
        if (coursesSelectionBar) coursesSelectionBar.style.display = 'none';
        selectedCourseIds.clear();
        updateSelectionUI();
        return;
      }
      if (coursesEmpty) coursesEmpty.style.display = 'none';

      // La sélection par cases à cocher n'a plus de sens dans une arborescence :
      // la suppression se fait par matière ou par document.
      if (coursesSelectionBar) coursesSelectionBar.style.display = 'none';
      selectedCourseIds.clear();
      updateSelectionUI();

      // Même arborescence que la page Cours (matières → dossiers → documents).
      const tree = groupCoursesBySubject(cachedCourses);
      const subjects = sortSubjects(tree.values());

      subjects.forEach((sData) => {
        const docCount = Array.from(sData.folders.values()).reduce((n, list) => n + list.length, 0);
        if (docCount === 0) return;

        const card = document.createElement('article');
        card.className = 'panel espace-subject';

        const head = document.createElement('header');
        head.className = 'espace-subject-head';

        const titles = document.createElement('div');
        const title = document.createElement('h3');
        title.className = 'course-card-title';
        title.textContent = sData.subject;
        const meta = document.createElement('span');
        meta.className = 'meta';
        meta.textContent = `${sData.folders.size} dossier${sData.folders.size > 1 ? 's' : ''} · ${docCount} document${docCount > 1 ? 's' : ''}`;
        titles.append(title, meta);

        const btnDelSubject = document.createElement('button');
        btnDelSubject.type = 'button';
        btnDelSubject.className = 'btn btn--danger btn--sm';
        btnDelSubject.textContent = 'Supprimer la matière';
        btnDelSubject.addEventListener('click', async () => {
          const rows = cachedCourses.filter((c) => c.id && courseSubject(c) === sData.subject);
          if (rows.length === 0) return;
          const message = `Supprimer définitivement « ${sData.subject} » (${rows.length} fiche${rows.length > 1 ? 's' : ''} de cours) ? Cette action est irréversible.`;
          if (!confirm(message)) return;

          const ids = rows.map((r) => r.id!);
          const idSet = new Set(ids);
          cachedCourses = cachedCourses.filter((c) => !c.id || !idSet.has(c.id));
          if (badgeCourses) badgeCourses.textContent = String(cachedCourses.length);
          renderCourses();

          try {
            await deleteBatchUserCourses(ids);
            notify(`« ${sData.subject} » supprimé.`);
          } catch (err: any) {
            notify('Erreur lors de la suppression : ' + formatSupabaseError(err), true);
            await loadCourses();
          }
        });

        head.append(titles, btnDelSubject);

        const foldersWrap = document.createElement('div');
        foldersWrap.className = 'espace-folders';

        sortFolders(sData).forEach((folderName) => {
          const files = (sData.folders.get(folderName) || [])
            .slice()
            .sort((a, b) => a.title.localeCompare(b.title, 'fr', { numeric: true, sensitivity: 'base' }));
          if (files.length === 0) return;

          const block = document.createElement('section');
          block.className = 'espace-folder';

          const folderTitle = document.createElement('h4');
          folderTitle.className = 'espace-folder-title';
          folderTitle.textContent = folderName;

          const list = document.createElement('ul');
          list.className = 'espace-doc-list';

          files.forEach((file) => {
            const item = document.createElement('li');
            item.className = 'espace-doc';

            const badge = document.createElement('span');
            badge.className = 'espace-doc-badge';
            badge.textContent = (file.ext || 'doc').toUpperCase().slice(0, 4);

            const open = document.createElement('button');
            open.type = 'button';
            open.className = 'espace-doc-name';
            open.textContent = file.title;
            open.title = 'Consulter ce document';
            open.addEventListener('click', () => {
              openPdfViewer({
                title: file.title,
                subject: sData.subject,
                folder: folderName,
                fileUrl: file.url,
                rawCourse: file.rawCourse,
                content: file.content,
                ext: file.ext,
              });
            });

            item.append(badge, open);

            // Suppression possible seulement quand le document est une ligne de cours
            // à lui seul (et non un fichier listé dans l'arborescence d'une matière).
            const standalone = file.rawCourse && file.rawCourse.id && file.rawCourse.title === file.title;
            if (standalone) {
              const del = document.createElement('button');
              del.type = 'button';
              del.className = 'espace-doc-del';
              del.title = 'Supprimer ce document';
              del.textContent = '✕';
              del.addEventListener('click', async () => {
                if (!confirm(`Supprimer définitivement « ${file.title} » ?`)) return;
                item.remove();
                cachedCourses = cachedCourses.filter((c) => c.id !== file.rawCourse!.id);
                if (badgeCourses) badgeCourses.textContent = String(cachedCourses.length);
                try {
                  await deleteUserCourse(file.rawCourse!.id!);
                  notify('Document supprimé.');
                } catch (err: any) {
                  notify(formatSupabaseError(err), true);
                  await loadCourses();
                }
              });
              item.append(del);
            }

            list.appendChild(item);
          });

          block.append(folderTitle, list);
          foldersWrap.appendChild(block);
        });

        card.append(head, foldersWrap);
        coursesGrid.appendChild(card);
      });
    }

    chkSelectAllCourses?.addEventListener('change', () => {
      if (chkSelectAllCourses.checked) {
        cachedCourses.forEach((c) => {
          if (c.id) selectedCourseIds.add(c.id);
        });
      } else {
        selectedCourseIds.clear();
      }
      updateSelectionUI();
    });

    btnDeleteSelectedCourses?.addEventListener('click', async () => {
      const count = selectedCourseIds.size;
      if (count === 0) return;
      const confirmMsg =
        count === 1
          ? 'Supprimer définitivement ce cours ?'
          : `Supprimer définitivement les ${count} cours sélectionnés ? Cette action est irréversible.`;

      if (confirm(confirmMsg)) {
        const idsToDelete = Array.from(selectedCourseIds);
        const toDeleteSet = new Set(idsToDelete);

        // 1. Suppression optimiste immédiate dans l'interface (0 ms)
        cachedCourses = cachedCourses.filter((c) => c.id && !toDeleteSet.has(c.id));
        selectedCourseIds.clear();
        if (badgeCourses) badgeCourses.textContent = String(cachedCourses.length);
        renderCourses();
        updateSelectionUI();

        try {
          notify(`Suppression de ${count} cours en cours...`);
          await deleteBatchUserCourses(idsToDelete);
          notify(count === 1 ? 'Cours supprimé avec succès.' : `${count} cours supprimés avec succès.`);
        } catch (err: any) {
          notify('Erreur lors de la suppression : ' + formatSupabaseError(err), true);
          await loadCourses();
        }
      }
    });

    btnPurgeAllCourses?.addEventListener('click', async () => {
      if (cachedCourses.length === 0) return;
      if (confirm(`Attention : Voulez-vous vraiment supprimer l'intégralité de vos ${cachedCourses.length} cours ?\n\nCette action est irréversible. Votre emploi du temps sera conservé.\n\nContinuer ?`)) {
        // 1. Suppression optimiste immédiate dans l'interface (0 ms)
        cachedCourses = [];
        selectedCourseIds.clear();
        if (badgeCourses) badgeCourses.textContent = '0';
        renderCourses();
        updateSelectionUI();

        try {
          notify('Suppression de tous vos cours en cours...');
          await clearUserCourses();
          notify('Tous vos cours ont été supprimés avec succès.');
        } catch (err: any) {
          notify('Erreur lors de la suppression : ' + formatSupabaseError(err), true);
          await loadCourses();
        }
      }
    });

    // Importation des 6 matières locales pré-configurées
