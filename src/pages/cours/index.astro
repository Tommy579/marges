---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CourseManagerModal from '../../components/CourseManagerModal.astro';
import PdfViewerModal from '../../components/PdfViewerModal.astro';
import { getCourses, formatFileSize } from '../../utils/courses';
import { url } from '../../utils/url';

const subjects = getCourses();
const totalCourses = subjects.length;
const totalFiles = subjects.reduce((acc, s) => acc + s.stats.totalFiles, 0);
const totalPdfs = subjects.reduce((acc, s) => acc + s.stats.pdfCount, 0);

const subjectsList = subjects.map((s) => ({
  id: s.id,
  name: s.name,
  subfolders: s.folder.subfolders.map((f) => f.name),
}));
---

<Base
  title="Mes Cours"
  description="Accès direct et visionneuse de vos cours, TD, travaux pratiques et documents académiques."
>
  <div class="container container--wide app-page courses-page" data-courses-root data-subjects={JSON.stringify(subjectsList)}>
    <header class="page-header courses-hero">
      <div class="courses-hero-top">
        <div>
          <h1 class="courses-title">Mes Cours<span style="color: var(--accent);">.</span></h1>
          <p class="courses-motto">Supports de cours, énoncés de TD et fiches de révisions.</p>
        </div>
        <div class="courses-hero-actions">
          <button type="button" class="btn btn--sm" id="btn-sync-cloud-files" title="Envoie vers le cloud les documents enregistrés sur cet appareil. Cette vérification est faite automatiquement après chaque import : le bouton sert à la relancer.">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span id="sync-cloud-label">Sync Cloud</span>
          </button>
          <a href={url('/notes/')} class="btn btn--sm" title="Prendre des notes de cours">
            <Icon name="edit" size={14} />
            <span>Prendre des notes</span>
          </a>
          <button type="button" class="btn btn--primary btn--sm" id="btn-open-add-course">
            <Icon name="folder" size={14} />
            Ajouter / Classer un cours
          </button>
          <a href={url('/configuration/')} class="btn btn--sm">
            <Icon name="settings" size={14} />
            Configuration
          </a>
        </div>
      </div>
      <div class="meta stats-bar">
        <span>{totalCourses} matières</span>
        <span class="sep">·</span>
        <span>{totalFiles} fichiers</span>
        <span class="sep">·</span>
        <span>{totalPdfs} documents PDF</span>
      </div>
    </header>

    <!-- Grille des matières avec DA Marges -->
    <div class="subjects-grid" id="subjects-container">
      {subjects.map((sub) => (
        <section class="panel subject-card" id={`folder-${sub.id}`} data-subject-card={sub.name}>
          <div class="subject-header">
            <div class="subject-title-wrap">
              <span class="subject-initial" aria-hidden="true">{sub.name.charAt(0).toUpperCase()}</span>
              <div>
                <h2 class="subject-title">{sub.name}</h2>
                <p class="subject-meta meta">
                  <span class="subject-count-label">
                    {sub.stats.totalFiles} fichiers · {sub.stats.pdfCount} PDF
                    {sub.stats.docCount ? ` · ${sub.stats.docCount} Word` : ''}
                    {sub.stats.codeCount ? ` · ${sub.stats.codeCount} code` : ''}
                  </span>
                </p>
              </div>
            </div>
            <button
              type="button"
              class="btn btn--sm btn-add-in-subject"
              data-subject-target={sub.name}
              title={`Ajouter un document dans ${sub.name}`}
            >
              + Ajouter un document
            </button>
          </div>

          <!-- Arborescence des dossiers & fichiers -->
          <div class="folder-tree" id={`tree-${sub.id}`}>
            {sub.folder.subfolders.map((td) => (
              <div class="td-section" data-folder-name={td.name}>
                <div class="td-header">
                  <Icon name="folder" size={16} class="td-folder-icon" />
                  <h3 class="td-title">{td.name}</h3>
                  <span class="meta td-count">{td.files.length}</span>
                </div>
                <ul class="file-list" role="list">
                  {td.files.map((file) => (
                    <li
                      class="file-item static-file-item"
                      data-subject={sub.name}
                      data-folder={td.name}
                      data-filename={file.name}
                      data-fileurl={file.url}
                    >
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name" title={`Ouvrir ${file.name}`}>
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <a href={file.viewerUrl} class="btn-consulter">
                          Consulter <Icon name="arrow-right" size={13} />
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            {sub.folder.files.length > 0 && (
              <div class="td-section" data-folder-name="Documents racines">
                <div class="td-header">
                  <Icon name="file" size={16} class="td-folder-icon" />
                  <h3 class="td-title">Documents racines</h3>
                  <span class="meta td-count">{sub.folder.files.length}</span>
                </div>
                <ul class="file-list" role="list">
                  {sub.folder.files.map((file) => (
                    <li
                      class="file-item static-file-item"
                      data-subject={sub.name}
                      data-folder="Documents racines"
                      data-filename={file.name}
                      data-fileurl={file.url}
                    >
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name" title={`Ouvrir ${file.name}`}>
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <a href={file.viewerUrl} class="btn-consulter">
                          Consulter <Icon name="arrow-right" size={13} />
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>

    <!-- État vide quand aucune matière n'est encore présente -->
    <div id="courses-empty-state" class="panel" style={subjects.length === 0 ? 'text-align: center; padding: 2.5rem 1.5rem;' : 'display: none; text-align: center; padding: 2.5rem 1.5rem;'}>
      <p style="font-family: var(--font-text); font-size: 1.2rem; margin: 0 0 0.35rem; font-weight: 600;">Aucune matière enregistrée pour le moment</p>
      <p class="meta" style="margin: 0 0 1.25rem;">Créez votre première matière ou importez un dossier de cours pour retrouver vos PDF, TD et fiches de révision ici.</p>
      <button type="button" class="btn btn--primary btn--sm" id="btn-empty-add-course">
        <Icon name="folder" size={14} />
        Ajouter ma première matière
      </button>
    </div>

    <!-- Modale de création et de classement de cours -->
    <CourseManagerModal />

    <!-- Lecteur PDF immersif -->
    <PdfViewerModal />

  </div>
</Base>

<script>
  import {
    fetchUserCourses,
    getUserCoursesImmediate,
    getCurrentUserCached,
    createUserCourse,
    updateUserCourse,
    deleteUserCourse,
    type DbCourse,
  } from '../../utils/supabase';
  import {
    deleteUnifiedNote,
    getLocalNotes,
    noteToDbCourse,
  } from '../../utils/notes';
  import { setupPdfViewerModal, openPdfViewer } from '../../utils/pdfViewer';
  import {
    saveDocumentFile,
    deleteDocumentFile,
    syncLocalFilesToSupabaseStorage,
  } from '../../utils/fileStorage';
  import { processFolderUpload } from '../../utils/courseImport';
  import { toast as notifyToast } from '../../utils/toast';
  import { esc } from '../../utils/escape';

  function initCourseManager() {
    const root = document.querySelector('[data-courses-root]');
    if (!root) return;

    const modal = document.getElementById('modal-manage-course') as HTMLDialogElement;
    const btnOpen = document.getElementById('btn-open-add-course');
    const btnClose = document.getElementById('btn-close-course-modal');
    const btnCancelSubject = document.getElementById('btn-cancel-subject');
    const btnCancelFile = document.getElementById('btn-cancel-file');
    const btnCancelNote = document.getElementById('btn-cancel-note');

    const formSubject = document.getElementById('form-create-subject') as HTMLFormElement;
    const formFile = document.getElementById('form-upload-file') as HTMLFormElement;
    const formNote = document.getElementById('form-create-note') as HTMLFormElement;

    const selectTargetSubject = document.getElementById('select-target-subject') as HTMLSelectElement;
    const selectTargetFolder = document.getElementById('select-target-folder') as HTMLSelectElement;
    const selectNoteSubject = document.getElementById('select-note-subject') as HTMLSelectElement;
    const selectNoteFolder = document.getElementById('select-note-folder') as HTMLSelectElement;
    const groupCustomFolder = document.getElementById('group-custom-folder');
    const inputCustomFolder = document.getElementById('input-custom-folder') as HTMLInputElement;

    const noteTitleInput = document.getElementById('note-title-input') as HTMLInputElement;
    const noteBodyInput = document.getElementById('note-body-input') as HTMLTextAreaElement;

    // 1. Lire les matières initiales
    const rawSubjects = root.getAttribute('data-subjects');
    const baseSubjects: Array<{ id: string; name: string; subfolders: string[] }> = rawSubjects ? JSON.parse(rawSubjects) : [];

    let cachedDbCourses: DbCourse[] = [];

    const showToast = (msg: string, tone: 'info' | 'success' | 'error' = 'success') => {
      notifyToast(msg, tone);
    };

    // Mise à jour de la liste déroulante des matières (Socle + Supabase)
    function populateSubjectsSelect(selectedName?: string) {
      const dbSubjectNames = new Set<string>();
      cachedDbCourses.forEach((c) => {
        if (c.tags && c.tags.includes('note')) return;
        if (c.tags && c.tags.includes('Matière') && c.title) {
          dbSubjectNames.add(c.title.trim());
        } else if (c.tags && c.tags.length > 0) {
          const cleanTags = c.tags.filter(
            (t) =>
              t !== 'Université' &&
              t !== 'Dossier importé' &&
              t !== 'Matière' &&
              t !== 'Supports de cours' &&
              t !== 'note' &&
              !t.startsWith('icon:') &&
              t !== 'Sans matière' &&
              t !== 'Notes libres' &&
              t !== 'Fiches de révisions' &&
              t !== 'CM' &&
              t !== 'TD' &&
              t !== 'Documents racines'
          );
          if (cleanTags.length > 0) dbSubjectNames.add(cleanTags[0]);
        }
      });

      const allNames = Array.from(new Set([...baseSubjects.map((s) => s.name), ...Array.from(dbSubjectNames)])).sort((a, b) => a.localeCompare(b));

      [selectTargetSubject, selectNoteSubject].forEach((sel) => {
        if (!sel) return;
        sel.innerHTML = '<option value="" disabled selected>Sélectionner une matière...</option>';
        allNames.forEach((name) => {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          if (selectedName && selectedName === name) opt.selected = true;
          sel.appendChild(opt);
        });
      });
    }

    // Gestion des onglets
    const tabs = document.querySelectorAll<HTMLButtonElement>('.modal-tab');
    const panels = document.querySelectorAll<HTMLElement>('.modal-tab-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach((p) => p.classList.remove('active'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        if (target) {
          document.querySelector(`[data-panel="${target}"]`)?.classList.add('active');
        }
      });
    });

    // Choix sous-dossier custom
    selectTargetFolder?.addEventListener('change', () => {
      if (groupCustomFolder) {
        groupCustomFolder.style.display = selectTargetFolder.value === '__custom__' ? 'grid' : 'none';
      }
    });

    // Initialisation du lecteur interactif de documents (PDF, Word, texte, code)
    setupPdfViewerModal();

    document.querySelectorAll<HTMLElement>('.static-file-item').forEach((item) => {
      const filename = item.getAttribute('data-filename') || '';
      const subject = item.getAttribute('data-subject') || '';
      const folder = item.getAttribute('data-folder') || '';
      const fileUrl = item.getAttribute('data-fileurl') || '';

      const handleStaticConsult = (e: MouseEvent) => {
        if (e.button === 0 && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
          e.preventDefault();
          openPdfViewer({
            title: filename,
            subject,
            folder,
            fileUrl,
          });
        }
      };

      item.querySelector('.file-name')?.addEventListener('click', handleStaticConsult as any);
      item.querySelector('.btn-consulter')?.addEventListener('click', handleStaticConsult as any);
    });

    const btnCancelFolder = document.getElementById('btn-cancel-folder');
    const btnStartFolderImport = document.getElementById('btn-start-folder-import') as HTMLButtonElement | null;
    const courseFolderInput = document.getElementById('course-folder-input') as HTMLInputElement | null;
    const folderImportStatus = document.getElementById('folder-import-status');

    // Sélectionner un dossier ne lance plus l'import : on mémorise le choix et on
    // attend le clic sur « Lancer l'importation ». Avant, le bouton se contentait de
    // rouvrir le sélecteur de fichiers et l'import partait à la sélection.
    let pendingFolderFiles: File[] = [];

    function setFolderImportState(count: number) {
      if (btnStartFolderImport) btnStartFolderImport.disabled = count === 0;
      if (folderImportStatus) {
        if (count > 0) {
          folderImportStatus.style.display = 'block';
          folderImportStatus.textContent = `${count} fichier${count > 1 ? 's' : ''} sélectionné${count > 1 ? 's' : ''} — cliquez sur « Lancer l'importation ».`;
        } else {
          folderImportStatus.style.display = 'none';
          folderImportStatus.textContent = '';
        }
      }
    }

    setFolderImportState(0);

    btnCancelFolder?.addEventListener('click', () => {
      pendingFolderFiles = [];
      if (courseFolderInput) courseFolderInput.value = '';
      setFolderImportState(0);
      modal?.close();
    });

    courseFolderInput?.addEventListener('change', () => {
      pendingFolderFiles = courseFolderInput.files ? Array.from(courseFolderInput.files) : [];
      setFolderImportState(pendingFolderFiles.length);
    });

    btnStartFolderImport?.addEventListener('click', async () => {
      if (pendingFolderFiles.length === 0) {
        if (folderImportStatus) {
          folderImportStatus.style.display = 'block';
          folderImportStatus.textContent = "Choisissez d'abord un dossier ci-dessus.";
        }
        return;
      }

      const filesToImport = pendingFolderFiles.slice();
      if (btnStartFolderImport) btnStartFolderImport.disabled = true;

      try {
        if (folderImportStatus) {
          folderImportStatus.style.display = 'block';
          folderImportStatus.textContent = 'Importation des documents en cours...';
        }
        const res = await processFolderUpload(filesToImport, (msg) => {
          if (folderImportStatus) folderImportStatus.textContent = msg;
        });
        showToast(`${res.subjectCount} matière(s) et ${res.fileCount} fichier(s) importés !`);
        pendingFolderFiles = [];
        if (courseFolderInput) courseFolderInput.value = '';
        setFolderImportState(0);
        modal?.close();
        await loadAndRenderSupabaseCourses();
      } catch (err: any) {
        showToast('Erreur importation dossier : ' + err.message, 'error');
        setFolderImportState(pendingFolderFiles.length);
      }
    });

    // Ouvrir / Fermer modale
    function openModal(defaultTab: 'tab-subject' | 'tab-file' | 'tab-folder' | 'tab-note' = 'tab-subject', presetSubject?: string) {
      populateSubjectsSelect(presetSubject);
      tabs.forEach((t) => {
        const isMatch = t.getAttribute('data-tab') === defaultTab;
        t.classList.toggle('active', isMatch);
        t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });
      panels.forEach((p) => {
        p.classList.toggle('active', p.getAttribute('data-panel') === defaultTab);
      });

      // Une sélection de dossier abandonnée (fermeture par ✕) ne doit pas rester
      // en mémoire et surprendre au prochain import.
      pendingFolderFiles = [];
      if (courseFolderInput) courseFolderInput.value = '';
      setFolderImportState(0);

      if (modal) modal.showModal();
    }

    btnOpen?.addEventListener('click', () => openModal('tab-subject'));
    document.getElementById('btn-empty-add-course')?.addEventListener('click', () => openModal('tab-subject'));
    btnClose?.addEventListener('click', () => modal?.close());
    btnCancelSubject?.addEventListener('click', () => modal?.close());
    btnCancelFile?.addEventListener('click', () => modal?.close());
    btnCancelNote?.addEventListener('click', () => modal?.close());

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Boutons rapides "Ajouter un document" sur chaque carte matière
    document.querySelectorAll<HTMLButtonElement>('.btn-add-in-subject').forEach((btn) => {
      btn.addEventListener('click', () => {
        const subName = btn.getAttribute('data-subject-target') || '';
        openModal('tab-file', subName);
      });
    });

    // 2. Traitement formulaire : Créer une nouvelle matière (enregistrée dans Supabase)
    formSubject?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const inputName = document.getElementById('new-subject-name') as HTMLInputElement;
      const name = inputName.value.trim();
      if (!name) return;

      const subfolders: string[] = [];
      if ((document.getElementById('preset-cm') as HTMLInputElement).checked) subfolders.push('CM');
      if ((document.getElementById('preset-td') as HTMLInputElement).checked) subfolders.push('TD');
      if ((document.getElementById('preset-revisions') as HTMLInputElement).checked) subfolders.push('Fiches de révisions');

      try {
        await createUserCourse({
          title: name,
          tags: [name, 'Matière'],
          body_md: `## Matière : ${name}\n\nSous-dossiers configurés : ${subfolders.join(', ')}`,
        });
        modal?.close();
        inputName.value = '';
        showToast(`Matière « ${name} » enregistrée dans votre banque de cours Supabase !`);
        await loadAndRenderSupabaseCourses();
      } catch (err: any) {
        showToast('Erreur enregistrement Supabase : ' + (err.message || err), 'error');
      }
    });

    // 3. Traitement formulaire : Importer / classer un document (Supabase + IndexedDB)
    formFile?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const targetSubject = selectTargetSubject.value;
      let targetFolder = selectTargetFolder.value;
      if (targetFolder === '__custom__') {
        targetFolder = inputCustomFolder.value.trim() || 'Documents racines';
      }

      const fileInput = document.getElementById('course-file-input') as HTMLInputElement;
      if (!fileInput.files || !fileInput.files[0] || !targetSubject) return;

      const file = fileInput.files[0];
      const user = getCurrentUserCached();
      const userId = user?.id || '';

      // Sauvegarde immédiate dans IndexedDB et téléversement transparent vers Supabase Storage
      await saveDocumentFile(file, {
        userId,
        subject: targetSubject,
        folder: targetFolder,
        fileName: file.name,
      });

      const reader = new FileReader();
      reader.onload = async (evt) => {
        const dataUrl = evt.target?.result as string;
        try {
          const body_md = file.size <= 2 * 1024 * 1024 ? dataUrl : `[Fichier local : ${file.name}]`;
          await createUserCourse({
            title: file.name,
            tags: [targetSubject, targetFolder],
            body_md,
          });
          modal?.close();
          fileInput.value = '';
          if (inputCustomFolder) inputCustomFolder.value = '';
          showToast(`Document « ${file.name} » enregistré et synchronisé !`);
          await loadAndRenderSupabaseCourses();
        } catch (err: any) {
          showToast('Erreur enregistrement Supabase : ' + err.message, 'error');
        }
      };

      reader.readAsDataURL(file);
    });

    // 4. Traitement formulaire : Rédiger une note / cours Markdown (Supabase)
    formNote?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const targetSubject = selectNoteSubject.value;
      const targetFolder = selectNoteFolder.value || 'Fiches de révisions';
      const title = noteTitleInput.value.trim();
      const body_md = noteBodyInput.value.trim();
      if (!targetSubject || !title) return;

      try {
        await createUserCourse({
          title,
          tags: [targetSubject, targetFolder],
          body_md,
        });
        modal?.close();
        noteTitleInput.value = '';
        noteBodyInput.value = '';
        showToast(`Cours « ${title} » enregistré dans Supabase !`);
        await loadAndRenderSupabaseCourses();
      } catch (err: any) {
        showToast('Erreur enregistrement Supabase : ' + err.message, 'error');
      }
    });

    // 4. Charger et afficher les cours depuis la base Supabase avec classement intelligent
    function getFolderSortScore(name: string): number {
      const low = name.toLowerCase();
      if (low === 'cm' || low.includes('cours')) return 10;
      if (low === 'td' || low.includes('dirigé')) return 20;
      if (low === 'tp' || low.includes('pratique')) return 30;
      if (low.includes('fiche') || low.includes('revision') || low.includes('révision')) return 40;
      if (low.includes('programme') || low.includes('notion') || low.includes('clé')) return 50;
      if (low.includes('document') || low.includes('général') || low.includes('racine')) return 60;
      return 70;
    }

    function parseMarkdownSubfolders(body_md: string) {
      if (!body_md) return [];
      const sections: Array<{ folderName: string; items: Array<{ title: string; url?: string; ext: string; content?: string }> }> = [];
      const lines = body_md.split('\n');
      let currentFolder = '';
      let currentItems: Array<{ title: string; url?: string; ext: string; content?: string }> = [];

      for (let line of lines) {
        const trimmed = line.trim();
        if (trimmed.startsWith('### ')) {
          if (currentFolder && currentItems.length > 0) {
            sections.push({ folderName: currentFolder, items: currentItems });
          }
          currentFolder = trimmed.replace(/^###\s+/, '').trim();
          currentItems = [];
        } else if (trimmed.startsWith('- ') || trimmed.startsWith('* ')) {
          const raw = trimmed.replace(/^[-*]\s+/, '').trim();
          const linkMatch = raw.match(/^\[([^\]]+)\]\(([^)]+)\)/);
          let title = raw;
          let fileUrl = '';
          if (linkMatch) {
            title = linkMatch[1];
            fileUrl = linkMatch[2];
          }
          let ext = 'note';
          const extMatch = title.match(/\.([a-zA-Z0-9]+)(\s|$|\))/);
          if (extMatch) {
            ext = extMatch[1].toLowerCase();
          } else if (fileUrl && fileUrl.endsWith('.pdf')) {
            ext = 'pdf';
          }
          currentItems.push({ title, url: fileUrl, ext, content: raw });
        }
      }

      if (currentFolder && currentItems.length > 0) {
        sections.push({ folderName: currentFolder, items: currentItems });
      }

      if (sections.length === 0 && currentItems.length > 0) {
        sections.push({ folderName: 'Programme & Notions-clés', items: currentItems });
      }

      return sections;
    }

    function renderCoursesGrid(dbCourses: DbCourse[]) {
      const container = document.querySelector('.subjects-grid');
      if (!container) return;

      document.querySelectorAll('.file-item-supabase').forEach((el) => el.remove());
      document.querySelectorAll('.subject-card-supabase').forEach((el) => el.remove());

      // Nettoyer les sous-dossiers devenus vides
      document.querySelectorAll('.folder-tree .td-section').forEach((sec) => {
        const fileList = sec.querySelector('.file-list');
        if (fileList && fileList.children.length === 0) {
          sec.remove();
        }
      });

      if (!dbCourses || dbCourses.length === 0) {
        const statsBar = document.querySelector('.courses-hero .stats-bar');
        const staticCards = document.querySelectorAll('.subject-card:not(.subject-card-supabase)');
        const staticFiles = document.querySelectorAll('.static-file-item');
        if (statsBar) {
          statsBar.innerHTML = `
            <span>${staticCards.length} matière${staticCards.length > 1 ? 's' : ''}</span>
            <span class="sep">·</span>
            <span>${staticFiles.length} fichier${staticFiles.length > 1 ? 's' : ''}</span>
            <span class="sep">·</span>
            <span>Synchronisé</span>
          `;
        }
        populateSubjectsSelect();
        return;
      }

      // Regrouper par matière
      interface SubjectData {
        name: string;
        folders: Map<string, Array<{ id?: string; title: string; url?: string; ext: string; rawCourse?: DbCourse; content?: string }>>;
      }

      const subjectsMap = new Map<string, SubjectData>();

      dbCourses.forEach((c) => {
        let isRootNote = false;

        // Détection des notes non affiliées (à la racine)
        if (c.tags && c.tags.includes('note')) {
          const hasRealSubject = c.tags.some(
            (t) =>
              !t.startsWith('icon:') &&
              t !== 'note' &&
              t !== 'Sans matière' &&
              t !== 'Notes libres' &&
              t !== 'Université' &&
              t !== 'Dossier importé' &&
              t !== 'Matière' &&
              t !== 'Supports de cours' &&
              t !== 'Fiches de révisions' &&
              t !== 'CM' &&
              t !== 'TD' &&
              t !== 'Documents racines'
          );
          if (!hasRealSubject) {
            isRootNote = true;
          }
        }

        let subject = '';
        if (isRootNote) {
          subject = 'Notes';
        } else {
          if (c.tags && c.tags.length > 0) {
            const cleanTags = c.tags.filter(
              (t) =>
                t !== 'Université' &&
                t !== 'Dossier importé' &&
                t !== 'Matière' &&
                t !== 'Supports de cours' &&
                t !== 'note' &&
                !t.startsWith('icon:') &&
                t !== 'Sans matière' &&
                t !== 'Notes libres' &&
                t !== 'Fiches de révisions' &&
                t !== 'CM' &&
                t !== 'TD' &&
                t !== 'Documents racines'
            );
            if (cleanTags.length > 0) subject = cleanTags[0];
          }
          if (!subject && c.tags && c.tags.includes('Matière') && c.title) subject = c.title;
          subject = (subject || '').trim();
          if (!subject) return;
        }

        if (!subjectsMap.has(subject)) {
          subjectsMap.set(subject, { name: subject, folders: new Map() });
        }
        const sData = subjectsMap.get(subject)!;

        if (isRootNote) {
          const folder = 'Notes libres';
          if (!sData.folders.has(folder)) {
            sData.folders.set(folder, []);
          }
          sData.folders.get(folder)!.push({
            id: c.id,
            title: c.title || 'Sans titre',
            ext: 'note',
            rawCourse: c,
            content: c.body_md,
          });
          return;
        }

        // Vérifier si c'est un module / conteneur de cours avec sous-dossiers markdown
        const parsedSections = parseMarkdownSubfolders(c.body_md);

        if (parsedSections.length > 0) {
          parsedSections.forEach((sec) => {
            if (!sData.folders.has(sec.folderName)) {
              sData.folders.set(sec.folderName, []);
            }
            const fList = sData.folders.get(sec.folderName)!;
            sec.items.forEach((item) => {
              const existingIdx = fList.findIndex((f) => f.title.toLowerCase() === item.title.toLowerCase());
              if (existingIdx === -1) {
                fList.push({
                  id: c.id,
                  title: item.title,
                  url: item.url,
                  ext: item.ext,
                  rawCourse: c,
                  content: item.content,
                });
              }
            });
          });
        } else if (!c.tags?.includes('Matière')) {
          // Document ou note individuel
          let folder = 'Fiches & Notes';
          if (c.tags && c.tags.length > 1) {
            const cleanTags = c.tags.filter((t) => t !== 'Université' && t !== 'Dossier importé' && t !== 'Matière' && t !== subject);
            if (cleanTags.length > 0) folder = cleanTags[0];
          }
          if (!sData.folders.has(folder)) {
            sData.folders.set(folder, []);
          }
          const isDataUrl = c.body_md && c.body_md.startsWith('data:');
          let ext = isDataUrl ? 'doc' : 'note';
          const extMatch = c.title.match(/\.([a-zA-Z0-9]+)$/);
          if (extMatch) ext = extMatch[1].toLowerCase();

          const fList = sData.folders.get(folder)!;
          const existingIdx = fList.findIndex((f) => f.title.toLowerCase() === c.title.toLowerCase());
          const entry = {
            id: c.id,
            title: c.title,
            ext,
            rawCourse: c,
            content: c.body_md,
          };
          if (existingIdx !== -1) {
            // Préférer l'entrée qui contient la DataURL directe du fichier
            if (isDataUrl || !fList[existingIdx].rawCourse?.body_md?.startsWith('data:')) {
              fList[existingIdx] = entry;
            }
          } else {
            fList.push(entry);
          }
        }
      });

      let totalSubjectCount = subjectsMap.size;
      let totalDocCount = 0;

      // Trier les matières (en plaçant 'Notes' au début si présente)
      const sortedSubjects = Array.from(subjectsMap.values()).sort((a, b) => {
        if (a.name === 'Notes') return -1;
        if (b.name === 'Notes') return 1;
        return a.name.localeCompare(b.name, 'fr');
      });

      sortedSubjects.forEach((sData) => {
        const subject = sData.name;
        const slugId = subject
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');

        let card = document.getElementById(`folder-${slugId}`);
        if (!card) {
          card = document.createElement('section');
          card.className = 'panel subject-card subject-card-supabase';
          card.id = `folder-${slugId}`;
          card.setAttribute('data-subject-card', subject);

          card.innerHTML = `
            <div class="subject-header">
              <div class="subject-title-wrap">
                <span class="subject-initial" aria-hidden="true">${esc(subject.charAt(0).toUpperCase())}</span>
                <div>
                  <h2 class="subject-title">${esc(subject)}</h2>
                  <p class="subject-meta meta">
                    <span class="subject-count-label">${subject === 'Notes' ? 'Notes non classées' : 'Matière synchronisée'}</span>
                  </p>
                </div>
              </div>
              <div class="subject-header-actions" style="display: flex; gap: 0.4rem; align-items: center;">
                ${subject === 'Notes'
                  ? `<a href="${import.meta.env.BASE_URL.replace(/\/$/, '')}/notes/" class="btn btn--sm" title="Ouvrir l'espace de notes">+ Nouvelle note</a>`
                  : `<button
                      type="button"
                      class="btn btn--sm btn-add-in-subject"
                      data-subject-target="${subject}"
                      title="Ajouter un document dans ${subject}"
                    >
                      + Ajouter un cours
                    </button>`
                }
                <button
                  type="button"
                  class="btn btn--danger btn--sm btn-del-subject"
                  data-subject-target="${subject}"
                  title="Supprimer la matière « ${subject} »"
                >
                  ✕
                </button>
              </div>
            </div>
            <div class="folder-tree" id="tree-${slugId}"></div>
          `;

          card.querySelector('.btn-add-in-subject')?.addEventListener('click', () => {
            openModal('tab-file', subject);
          });

          card.querySelector('.btn-del-subject')?.addEventListener('click', async () => {
            const confirmMsg =
              subject === 'Notes'
                ? 'Supprimer définitivement toutes les notes non classées ?'
                : `Supprimer définitivement la matière « ${subject} » et tous ses documents ?`;

            if (confirm(confirmMsg)) {
              // 1. Suppression optimiste immédiate de la carte dans le DOM (0 ms)
              card?.remove();
              showToast(subject === 'Notes' ? 'Notes non classées supprimées.' : `Matière « ${subject} » supprimée.`);

              try {
                if (subject === 'Notes') {
                  const rootNotes = getLocalNotes().filter((n) => !n.subject || !n.subject.trim());
                  for (const n of rootNotes) {
                    await deleteUnifiedNote(n.id);
                  }
                } else {
                  const current = getUserCoursesImmediate();
                  const toDelete = current.filter((c) => {
                    const isTitle = c.title.toLowerCase().trim() === subject.toLowerCase().trim();
                    const hasTag = c.tags && c.tags.some((t) => t.toLowerCase().trim() === subject.toLowerCase().trim());
                    return isTitle || hasTag;
                  });

                  for (const c of toDelete) {
                    await deleteUserCourse(c.id || c.title);
                  }
                }

                await loadAndRenderSupabaseCourses();
              } catch (err: any) {
                showToast('Erreur lors de la suppression : ' + err.message, 'error');
              }
            }
          });

          container.appendChild(card);
        }

        const tree = card.querySelector('.folder-tree');
        if (!tree) return;

        // Trier les dossiers selon l'ordre académique (CM, TD, TP, Fiches, etc.)
        const sortedFolderNames = Array.from(sData.folders.keys()).sort((a, b) => {
          const scoreDiff = getFolderSortScore(a) - getFolderSortScore(b);
          return scoreDiff !== 0 ? scoreDiff : a.localeCompare(b);
        });

        let subjectDocCount = 0;

        sortedFolderNames.forEach((folderName) => {
          const files = (sData.folders.get(folderName) || []).slice().sort((a, b) =>
            a.title.localeCompare(b.title, 'fr', { numeric: true, sensitivity: 'base' })
          );
          if (files.length === 0) return;
          subjectDocCount += files.length;
          totalDocCount += files.length;

          let tdSection = tree.querySelector(`[data-folder-name="${CSS.escape(folderName)}"]`);
          if (!tdSection) {
            tdSection = document.createElement('div');
            tdSection.className = 'td-section';
            tdSection.setAttribute('data-folder-name', folderName);
            tdSection.innerHTML = `
              <div class="td-header">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="td-folder-icon"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h3.6l2 2.2h7.4A2.5 2.5 0 0 1 21 9.7v7.8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/></svg>
                <h3 class="td-title">${esc(folderName)}</h3>
                <span class="meta td-count">${files.length}</span>
              </div>
              <ul class="file-list" role="list"></ul>
            `;
            tree.appendChild(tdSection);
          }

          const fileList = tdSection.querySelector('.file-list');
          if (!fileList) return;

          files.forEach((file) => {
            const li = document.createElement('li');
            li.className = 'file-item file-item-supabase';

            const isPdf = file.ext === 'pdf' || file.title.toLowerCase().endsWith('.pdf');
            const isBinaryDoc =
              isPdf ||
              file.ext === 'docx' ||
              file.ext === 'doc' ||
              /\.(pdf|docx?|odt|xlsx?|zip|tar|gz|png|jpe?g)$/i.test(file.title) ||
              Boolean(file.rawCourse?.body_md?.startsWith('data:'));
            const badgeClass = isPdf ? 'file-badge--pdf' : 'file-badge--doc';
            const badgeLabel = (file.ext || (isPdf ? 'pdf' : 'doc')).toUpperCase().slice(0, 4);

            li.innerHTML = `
              <div class="file-info">
                <span class="file-badge ${badgeClass}">${badgeLabel}</span>
                <span class="file-name" style="cursor: pointer;" title="Consulter ${esc(file.title)}">${esc(file.title)}</span>
              </div>
              <div class="file-actions meta">
                <button type="button" class="btn btn--sm btn-consult-db">Consulter</button>
                ${file.id && !isBinaryDoc ? `<a href="${import.meta.env.BASE_URL.replace(/\/$/, '')}/notes/?id=${encodeURIComponent(file.id)}" class="btn btn--sm" title="Ouvrir dans l'éditeur de notes">Éditer</a>` : ''}
                ${file.id && file.rawCourse ? `<button type="button" class="btn btn--danger btn--sm btn-del-db" title="Supprimer ce document">✕</button>` : ''}
              </div>
            `;

            const onConsult = () => {
              openPdfViewer({
                title: file.title,
                subject,
                folder: folderName,
                fileUrl: file.url,
                rawCourse: file.rawCourse,
                content: file.content,
                // Sans cette extension, une note sans suffixe passait pour un .doc
                // et le lecteur réclamait un fichier au lieu d'afficher le texte.
                ext: file.ext,
              });
            };

            li.querySelector('.file-name')?.addEventListener('click', onConsult);
            li.querySelector('.btn-consult-db')?.addEventListener('click', onConsult);

            li.querySelector('.btn-del-db')?.addEventListener('click', async () => {
              if (confirm(`Supprimer définitivement « ${file.title} » ?`)) {
                // 1. Suppression optimiste immédiate dans l'interface (0 ms)
                li.remove();
                const remaining = fileList.querySelectorAll('.file-item').length;
                const countBadge = tdSection.querySelector('.td-count');
                if (countBadge) countBadge.textContent = String(remaining);
                if (remaining === 0) tdSection.remove();

                showToast(`« ${file.title} » supprimé.`);

                try {
                  // 2. Nettoyage du document local et distant
                  if (file.id && (file.ext === 'note' || file.rawCourse?.tags?.includes('note'))) {
                    await deleteUnifiedNote(file.id);
                  } else {
                    await deleteDocumentFile(file.title, {
                      subject,
                      folder: folderName,
                    });

                    // 3. Mise à jour de la table Supabase
                    if (file.rawCourse && file.rawCourse.title === file.title) {
                      if (file.id) await deleteUserCourse(file.id);
                    } else if (file.rawCourse && file.rawCourse.id) {
                      const lines = (file.rawCourse.body_md || '').split('\n');
                      const filteredLines = lines.filter((l) => !l.includes(file.title));
                      const newBody = filteredLines.join('\n');
                      await updateUserCourse(file.rawCourse.id, { body_md: newBody });
                    }
                  }

                  await loadAndRenderSupabaseCourses();
                } catch (err: any) {
                  showToast(err.message, 'error');
                }
              }
            });

            fileList.appendChild(li);
          });

          const countBadge = tdSection.querySelector('.td-count');
          if (countBadge) countBadge.textContent = String(fileList.children.length);
        });

        // Mettre à jour le libellé de stats de la carte
        const countLabel = card.querySelector('.subject-count-label');
        if (countLabel) {
          if (subject === 'Notes') {
            countLabel.textContent = `${subjectDocCount} note${subjectDocCount > 1 ? 's non classées' : ' non classée'}`;
          } else {
            const folderCount = sortedFolderNames.length;
            countLabel.textContent = `${folderCount} dossier${folderCount > 1 ? 's' : ''} · ${subjectDocCount} document${subjectDocCount > 1 ? 's' : ''}`;
          }
        }
      });

      // Mettre à jour la barre de stats globale en haut de page
      const statsBar = document.querySelector('.courses-hero .stats-bar');
      if (statsBar && totalSubjectCount > 0) {
        statsBar.innerHTML = `
          <span>${totalSubjectCount} matière${totalSubjectCount > 1 ? 's' : ''}</span>
          <span class="sep">·</span>
          <span>${totalDocCount} document${totalDocCount > 1 ? 's' : ''}</span>
          <span class="sep">·</span>
          <span>Synchronisé</span>
        `;
      }

      const emptyEl = document.getElementById('courses-empty-state');
      if (emptyEl) {
        const hasAnyCard = container.querySelectorAll('.subject-card').length > 0;
        emptyEl.style.display = hasAnyCard ? 'none' : 'block';
      }

      populateSubjectsSelect();
    }

    // Gestion du bouton de synchronisation Cloud
    const btnSyncCloud = document.getElementById('btn-sync-cloud-files');
    const syncCloudLabel = document.getElementById('sync-cloud-label');
    let isSyncing = false;

    // Le cache local a une limite d'environ 5 Mo : au-delà, l'écriture échoue et
    // l'interface affiche des données périmées. Autant le dire.
    window.addEventListener('marges:cache-full', () => {
      notifyToast(
        "Mémoire du navigateur pleine : la liste locale des cours n'a pas pu être enregistrée. Supprimez d'anciens documents importés pour libérer de la place.",
        'error'
      );
    });

    async function triggerCloudSync(interactive = false) {
      if (isSyncing) return;
      isSyncing = true;
      if (syncCloudLabel) syncCloudLabel.textContent = 'Vérification...';

      // Un téléversement qui ne répond jamais laissait le bouton bloqué pour de bon
      // (isSyncing restait vrai). On borne l'attente.
      const watchdog = new Promise<never>((_, reject) => {
        setTimeout(() => reject(new Error('délai dépassé')), 60_000);
      });

      try {
        const res = await Promise.race([
          syncLocalFilesToSupabaseStorage((progress) => {
            if (syncCloudLabel) {
              syncCloudLabel.textContent = `${progress.current} / ${progress.total}`;
            }
          }),
          watchdog,
        ]);

        if (interactive) {
          const parts: string[] = [];
          if (res.syncedCount > 0) parts.push(`${res.syncedCount} envoyé${res.syncedCount > 1 ? 's' : ''}`);
          if (res.alreadyCount > 0) parts.push(`${res.alreadyCount} déjà présent${res.alreadyCount > 1 ? 's' : ''}`);
          if (res.totalCount === 0 && res.errors.length === 0) parts.push('aucun fichier local');
          if (res.errors.length > 0) parts.push(`${res.errors.length} non envoyé${res.errors.length > 1 ? 's' : ''}`);

          showToast(
            parts.length > 0 ? `Cloud : ${parts.join(', ')}.` : 'Cloud à jour.',
            res.errors.length > 0 ? 'info' : 'success'
          );
          if (res.errors.length > 0) {
            console.warn('[StorageSync] Fichiers ignorés:', res.errors);
          }
        }
      } catch (err: any) {
        if (interactive) {
          showToast(`Erreur synchronisation : ${err.message || err}`, 'error');
        }
      } finally {
        isSyncing = false;
        if (syncCloudLabel) syncCloudLabel.textContent = 'Sync Cloud';
      }
    }

    btnSyncCloud?.addEventListener('click', () => triggerCloudSync(true));

    async function loadAndRenderSupabaseCourses() {
      // 1. Affichage instantané depuis le cache local (0 milliseconde de latence)
      const immediateCourses = getUserCoursesImmediate();
      const localNotes = getLocalNotes();
      const existingIds = new Set(immediateCourses.map((c) => c.id));
      localNotes.forEach((n) => {
        if (!existingIds.has(n.id)) {
          immediateCourses.push(noteToDbCourse(n));
          existingIds.add(n.id);
        }
      });

      cachedDbCourses = immediateCourses;
      renderCoursesGrid(immediateCourses);

      // 2. Synchronisation transparente avec Supabase en arrière-plan
      try {
        const remoteCourses = await fetchUserCourses().catch(() => immediateCourses);
        if (remoteCourses) {
          const remoteIds = new Set(remoteCourses.map((c) => c.id));
          localNotes.forEach((n) => {
            if (!remoteIds.has(n.id)) {
              remoteCourses.push(noteToDbCourse(n));
              remoteIds.add(n.id);
            }
          });
          cachedDbCourses = remoteCourses;
          renderCoursesGrid(remoteCourses);
        }
      } catch (err) {
        console.warn('[Courses] Synchronisation réseau en arrière-plan:', err);
      }
    }

    // Réagir instantanément aux créations/suppressions de cours déclenchées depuis d'autres pages ou onglets
    window.addEventListener('marges:courses-changed', () => {
      loadAndRenderSupabaseCourses();
    });
    window.addEventListener('storage', (e) => {
      if (
        e.key &&
        (e.key.startsWith('marges_user_courses_') ||
          e.key === 'marges_deleted_courses_tombstones' ||
          e.key === 'marges_notes_cache' ||
          e.key === 'marges_guest_notes')
      ) {
        loadAndRenderSupabaseCourses();
      }
    });

    loadAndRenderSupabaseCourses();

    // Synchronisation automatique et discrète des fichiers locaux vers le cloud en arrière-plan
    setTimeout(() => {
      triggerCloudSync(false);
    }, 2000);
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCourseManager);
    } else {
      initCourseManager();
    }
    document.addEventListener('astro:page-load', initCourseManager);
  }
</script>

