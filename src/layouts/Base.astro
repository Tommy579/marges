---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { url } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE.description,
  image = url('/og-default.png'),
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.title}` : (SITE.tagline ? `${SITE.title} — ${SITE.tagline}` : SITE.title);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: Astro.site?.href,
  inLanguage: 'fr-FR',
};

const isEspace = Astro.url.pathname.includes('/espace');
---

<!doctype html>
<html lang="fr" data-is-espace={isEspace ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-flash : applique le thème et la couleur d'ambiance du compte Supabase actif -->
    <script is:inline>
      (function () {
        function savedTheme() {
          try {
            var local = localStorage.getItem('theme');
            if (local) return local;
          } catch (e) {}
          var match = document.cookie.match(/(?:^|; )theme=([^;]*)/);
          return match ? decodeURIComponent(match[1]) : null;
        }
        function savedAccountAmbiance() {
          try {
            for (var i = 0; i < localStorage.length; i++) {
              var k = localStorage.key(i);
              if (k && k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1) {
                var raw = localStorage.getItem(k);
                if (raw) {
                  var parsed = JSON.parse(raw);
                  var u = (parsed && parsed.user) || (parsed && parsed.currentSession && parsed.currentSession.user);
                  var c = u && u.user_metadata && u.user_metadata.ambiance_color;
                  if (c && typeof c === 'string' && c !== 'default') return c;
                }
              }
            }
          } catch (e) {}
          return null;
        }
        var t = savedTheme();
        if (t) document.documentElement.dataset.theme = t;
        var a = savedAccountAmbiance();
        if (a) {
          document.documentElement.dataset.ambiance = a;
        } else {
          delete document.documentElement.dataset.ambiance;
        }
        // Conserve le thème et l'ambiance lors des navigations (View Transitions)
        document.addEventListener('astro:before-swap', function (e) {
          var s = savedTheme();
          if (s) e.newDocument.documentElement.dataset.theme = s;
          var amb = document.documentElement.dataset.ambiance || savedAccountAmbiance();
          if (amb && amb !== 'default') {
            e.newDocument.documentElement.dataset.ambiance = amb;
          } else {
            delete e.newDocument.documentElement.dataset.ambiance;
          }
        });
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Favicons & App Icons -->
    <link rel="icon" href={`${url('/favicon.svg')}?v=3`} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${url('/favicon-32x32.png')}?v=3`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${url('/apple-touch-icon.png')}?v=3`} />
    <link rel="manifest" href={`${url('/site.webmanifest')}?v=3`} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — flux RSS`} href={new URL('rss.xml', Astro.site)} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta name="theme-color" content="#faf6f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={SITE.title} />
    <meta name="application-name" content={SITE.title} />
    <meta name="author" content={SITE.author} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.tagline ? `${SITE.title} — ${SITE.tagline}` : SITE.title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Données structurées -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? websiteLd)} />

    <!-- Verrouillage d'accès au site si non connecté -->
    <script is:inline define:vars={{ espaceUrl: url('/espace/') }}>
      (function () {
        try {
          var p = window.location.pathname.replace(/\/$/, '');
          var isEspace = p.endsWith('/espace');
          if (!isEspace) {
            var hasToken = false;
            for (var i = 0; i < localStorage.length; i++) {
              var k = localStorage.key(i);
              if (k && (k.indexOf('-auth-token') !== -1 || k === 'supabase.auth.token')) {
                hasToken = true;
                break;
              }
            }
            if (!hasToken) {
              var isConfig = window.location.pathname.indexOf('/configuration') !== -1;
              var target = isConfig
                ? espaceUrl + '?setup=1'
                : espaceUrl + '?redirect=' + encodeURIComponent(window.location.pathname + window.location.search);
              window.location.replace(target);
            }
          }
        } catch (e) {}
      })();
    </script>

    <script>
      import {
        getCurrentSession,
        getSupabase,
        applyAmbianceToDOM,
        normalizeAmbianceColor,
        fetchUserAmbianceColor,
      } from '../utils/supabase';
      import { startGlobalReminderWatcher } from '../utils/reminders';
      import { url } from '../utils/url';

      async function verifySession() {
        const p = window.location.pathname.replace(/\/$/, '');
        const isEspace = p.endsWith('/espace');
        try {
          const session = await getCurrentSession();
          if (!session || !session.user) {
            applyAmbianceToDOM('default');
            if (!isEspace) {
              const isConfig = window.location.pathname.includes('/configuration');
              const target = isConfig
                ? url('/espace/?setup=1')
                : url('/espace/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
              window.location.replace(target);
              return;
            }
          } else {
            document.documentElement.classList.add('is-authenticated');
            applyAmbianceToDOM(normalizeAmbianceColor(session.user.user_metadata?.ambiance_color));
            fetchUserAmbianceColor().catch(() => {});
            startGlobalReminderWatcher();
          }
        } catch (err) {
          if (!isEspace) {
            window.location.replace(url('/espace/'));
          }
        }
      }

      verifySession();
      document.addEventListener('astro:page-load', verifySession);

      try {
        const sb = getSupabase();
        sb.auth.onAuthStateChange((_event, session) => {
          const p = window.location.pathname.replace(/\/$/, '');
          const isEspace = p.endsWith('/espace');
          if (!session) {
            applyAmbianceToDOM('default');
            if (!isEspace) {
              document.documentElement.classList.remove('is-authenticated');
              window.location.replace(url('/espace/'));
            }
          } else if (session.user) {
            document.documentElement.classList.add('is-authenticated');
            applyAmbianceToDOM(normalizeAmbianceColor(session.user.user_metadata?.ambiance_color));
          }
        });
      } catch (e) {}
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus { outline: none; }

  /* Verrouillage du rendu tant que la session n'est pas vérifiée (sauf sur la page /espace/) */
  html:not([data-is-espace="true"]):not(.is-authenticated) body {
    opacity: 0;
    pointer-events: none;
    transition: opacity .15s ease;
  }
  html.is-authenticated body,
  html[data-is-espace="true"] body {
    opacity: 1;
    pointer-events: auto;
  }
</style>
