---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { SITE } from '../consts';
import { url } from '../utils/url';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: url('/textes/'), label: 'Textes', active: path.includes('/textes') || path.includes('/themes') },
  { href: url('/emploi-du-temps/'), label: 'Emploi du temps', short: 'Planning', active: path.includes('/emploi-du-temps') },
  { href: url('/cours/'), label: 'Cours', active: path.includes('/cours') },
  { href: url('/notes/'), label: 'Notes', active: path.includes('/notes') },
  { href: url('/rappels/'), label: 'Rappels', active: path.includes('/rappels') },
];
const isConfig = path.includes('/configuration');
---

<header class="site-header">
  <div class="container container--wide header-inner">
    <a class="brand" href={url('/')} aria-label={`${SITE.title} — accueil`}>
      {SITE.title}<span class="brand-dot" aria-hidden="true">.</span>
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.active ? 'page' : undefined}>
              {l.short ? (<><span class="label-long">{l.label}</span><span class="label-short">{l.short}</span></>) : l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <a
        class="icon-link"
        href={url('/espace/')}
        aria-current={path.includes('/espace') ? 'page' : undefined}
        aria-label="Mon espace & Connexion"
        title="Mon espace & Connexion"
        id="header-user-btn"
      >
        <Icon name="user" size={18} />
      </a>
      <a
        class="icon-link"
        href={url('/configuration/')}
        aria-current={isConfig ? 'page' : undefined}
        aria-label="Configuration"
        title="Configuration"
      >
        <Icon name="settings" size={18} />
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    min-height: 3.75rem;
  }

  .brand {
    font-family: var(--font-text);
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -.02em;
    text-decoration: none;
    font-style: italic;
    flex: none;
    padding-right: 1.25rem;
    border-right: 1px solid var(--line);
  }
  .brand-dot {
    color: var(--accent);
    font-style: normal;
  }
  .brand:hover { text-decoration: none; opacity: .78; }

  .nav { flex: 1; min-width: 0; }
  .nav ul {
    display: flex;
    gap: .25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: .88rem;
  }
  .nav a {
    position: relative;
    display: block;
    padding: .42rem .75rem;
    border-radius: var(--r-sm);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color .18s ease, background-color .18s ease;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: .75rem;
    right: .75rem;
    bottom: .15rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .22s var(--ease);
    border-radius: 2px;
  }
  .nav a:hover { color: var(--fg); background: color-mix(in srgb, var(--soft) 65%, transparent); }
  .nav a:hover::after { transform: scaleX(1); }
  .nav a[aria-current='page'] {
    color: var(--fg);
    font-weight: 600;
  }
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: .3rem;
    flex: none;
  }
  .icon-link {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    color: var(--muted);
    transition: color .15s ease, background-color .15s ease, border-color .15s ease, transform .3s var(--ease);
  }
  .icon-link:hover { color: var(--fg); background: var(--soft); border-color: var(--line); }
  .icon-link:hover :global(svg) { transform: rotate(22deg); transition: transform .35s var(--ease); }
  .icon-link[aria-current='page'] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  /* Tablette & Mobile : la navigation passe sur une 2e ligne défilable horizontalement */
  @media (max-width: 52rem) {
    .brand {
      padding-right: 0;
      border-right: none;
    }
    .header-inner {
      flex-wrap: wrap;
      padding-top: .45rem;
      padding-bottom: .35rem;
      gap: .3rem 1rem;
      min-height: 3.25rem;
    }
    .header-actions { margin-left: auto; }
    .nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) .35rem;
    }
    .nav ul {
      flex-wrap: nowrap;
      gap: .3rem;
    }
    .nav li {
      flex-shrink: 0;
    }
    .nav a {
      padding: .38rem .75rem;
      font-size: .86rem;
    }
    .nav::-webkit-scrollbar { display: none; }
    .icon-link { width: 2.5rem; height: 2.5rem; }
  }

  .label-short { display: none; }

  /* Téléphone : libellé court et liens répartis sur toute la largeur, sans défilement caché */
  @media (max-width: 30rem) {
    .label-long { display: none; }
    .label-short { display: inline; }
    .nav ul { justify-content: space-between; gap: 0; }
    .nav li { flex: 1 1 auto; }
    .nav a { padding: .5rem .4rem; text-align: center; }
    .nav a::after { left: .4rem; right: .4rem; }
  }

  @media print { .site-header { position: static; } }
</style>
